        <package android:name="ai.mistral.chat" />
        <package android:name="ai.inflection.pi" />
        <package android:name="com.suno.android" />
        <package android:name="io.elevenlabs.readerapp" />
        <package android:name="com.facebook.stella" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.thunderdog.challegram" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.facebook.orca" />
        <package android:name="jp.naver.line.android" />
        <package android:name="com.viber.voip" />
        <package android:name="com.kakao.talk" />
        <package android:name="com.google.android.apps.tachyon" />
        <package android:name="us.zoom.videomeetings" />
        <package android:name="com.twitter.android" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.instagram.barcelona" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.discord" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="xyz.blueskyweb.app" />
        <package android:name="org.joinmastodon.android" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.pinterest" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.tumblr" />
        <package android:name="com.quora.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="app.revanced.android.youtube" />
        <package android:name="app.rvx.android.youtube" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.wbd.stream" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.hulu.plus" />
        <package android:name="com.cbs.app" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="tv.abema" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.spotify.music" />
