+package libXray
+
+import "github.com/xtls/xray-core/common/conntrack"
+
+// ConnTrackSetEnabled turns the connection list on or off (PurpleBear).
+func ConnTrackSetEnabled(enabled bool) {
+	conntrack.SetEnabled(enabled)
+}
+
+// ConnTrackSnapshot returns the connection list as JSON: the active
+// connections, the closed ones with an id above closedAfter, and the bytes
+// moved per app and outbound since the process started.
+func ConnTrackSnapshot(closedAfter int64) string {
+	if closedAfter < 0 {
+		closedAfter = 0
+	}
+	return string(conntrack.Snapshot(uint64(closedAfter)))
+}
