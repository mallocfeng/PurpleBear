+// originalTargetIP returns the destination the connection was opened to,
+// before sniffing replaced it with a domain.
+func originalTargetIP(ctx routing.Context) (string, uint16, bool) {
+	if resolvable, ok := ctx.(*dns.ResolvableContext); ok {
+		ctx = resolvable.Context
+	}
+	sessionCtx, ok := ctx.(*routing_session.Context)
+	if !ok || sessionCtx.Outbound == nil {
+		return "", 0, false
+	}
+	target := sessionCtx.Outbound.OriginalTarget
+	if !target.IsValid() || !target.Address.Family().IsIP() {
+		return "", 0, false
+	}
+	return target.Address.IP().String(), uint16(target.Port), true
+}
